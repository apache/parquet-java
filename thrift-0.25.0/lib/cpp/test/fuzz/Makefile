#	$(AM_V_CXX_no)$(CXX) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) $(FuzzRoundtripJson_CXXFLAGS) $(CXXFLAGS) -c -o FuzzRoundtripJson-FuzzRoundtripJson.obj `if test -f 'FuzzRoundtripJson.cpp'; then $(CYGPATH_W) 'FuzzRoundtripJson.cpp'; else $(CYGPATH_W) '$(srcdir)/FuzzRoundtripJson.cpp'; fi`

mostlyclean-libtool:
	-rm -f *.lo

